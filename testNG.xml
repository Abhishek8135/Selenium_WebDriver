<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CCST_Suite" verbose="1">
    <test name="SmokeTests">
        <groups>
            <run>
                <include name="smoke"></include>
            </run>
        </groups>
        <classes>
            <class name="TestNG_AssertSoft"/>
            <class name="TestNG_LoginSauceDemo">
                <methods>
                    <include name="testPositiveLoginSauceDemo"/>
                </methods>
            </class>
            <class name="TestNG_MultipleWindows"/>
        </classes>
    </test>
</suite>